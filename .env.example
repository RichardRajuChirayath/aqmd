# Environment Variables

# Google Custom Search API (for Question Vault PDF discovery)
# Get your API key: https://developers.google.com/custom-search/v1/introduction
# Get your Search Engine ID: https://programmablesearchengine.google.com/
GOOGLE_SEARCH_API_KEY=your_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id_here

# Existing variables
OCR_SPACE_API_KEY=your_ocr_key
GROQ_API_KEY=your_groq_key
DATABASE_URL=your_database_url
